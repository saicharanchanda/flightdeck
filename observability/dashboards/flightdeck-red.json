{
  "uid": "flightdeck-red",
  "title": "Flightdeck — RED",
  "description": "Rate, errors and duration per service, plus the gateway SLOs. Probe and scrape routes (/healthz, /readyz, /metrics) are excluded. SLO rules: observability/rules/slo.yaml",
  "tags": ["flightdeck", "slo", "red"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    { "title": "SLO rules", "type": "link", "url": "https://github.com/saicharanchanda/flightdeck/blob/main/observability/rules/slo.yaml", "targetBlank": true },
    { "title": "Runbooks", "type": "link", "url": "https://github.com/saicharanchanda/flightdeck/tree/main/docs/runbooks", "targetBlank": true }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability SLI · 1h (SLO 99%)",
      "description": "Share of gateway API requests that did not return 5xx over the last hour.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_availability_good:ratio_rate1h", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "No traffic",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 0.99 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "auto", "justifyMode": "center" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latency SLI · 1h (SLO 95% < 300ms)",
      "description": "Share of gateway API requests faster than 250ms (the histogram bucket nearest below the 300ms target) over the last hour.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_latency_good:ratio_rate1h", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "No traffic",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 0.95 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "auto", "justifyMode": "center" }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Availability burn rate · 1h",
      "description": "How fast the availability error budget is being spent. 1 = exactly on budget; 6 = slow-burn ticket threshold; 14.4 = fast-burn page threshold.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_availability:burnrate1h", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 1,
          "min": 0,
          "max": 20,
          "noValue": "No traffic",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "orange", "value": 6 },
            { "color": "red", "value": 14.4 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Latency burn rate · 1h",
      "description": "How fast the latency error budget is being spent. 1 = on budget; 6 = ticket; 14.4 = page.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_latency:burnrate1h", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 1,
          "min": 0,
          "max": 20,
          "noValue": "No traffic",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "orange", "value": 6 },
            { "color": "red", "value": 14.4 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "Requests per second, excluding probes and scrapes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service) (rate(http_requests_total{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval]))", "legendFormat": "{{service}}", "range": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "noValue": "No requests", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate (5xx) by service",
      "description": "Share of requests returning 5xx. Shows 0 (not a gap) while a service has traffic and no errors.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum by (service) (rate(http_requests_total{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\", status=~\"5..\"}[$__rate_interval])) or sum by (service) (rate(http_requests_total{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval])) * 0) / (sum by (service) (rate(http_requests_total{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval])) > 0)", "legendFormat": "{{service}}", "range": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No requests",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "red", "value": 0.01 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 by service",
      "description": "From the request duration histogram (buckets 5ms … 5s). The dashed line is the 300ms latency SLO target.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 13, "w": 16, "h": 9 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (service, le) (rate(http_request_duration_seconds_bucket{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval])))", "legendFormat": "{{service}} p50", "range": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval])))", "legendFormat": "{{service}} p95", "range": true },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_request_duration_seconds_bucket{namespace=\"flightdeck\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval])))", "legendFormat": "{{service}} p99", "range": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No requests",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "orange", "value": 0.3 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Availability burn rate by window",
      "description": "The windows the alerts use. Fast-burn page: 1h and 5m above 14.4. Slow-burn ticket: 6h and 30m above 6.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 9 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_availability:burnrate5m", "legendFormat": "5m", "range": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_availability:burnrate30m", "legendFormat": "30m", "range": true },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_availability:burnrate1h", "legendFormat": "1h", "range": true },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:gateway_availability:burnrate6h", "legendFormat": "6h", "range": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "min": 0,
          "noValue": "No traffic",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "orange", "value": 6 },
            { "color": "red", "value": 14.4 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Notifier queue depth",
      "description": "Jobs waiting on the Redis list \"notifications\". Alert above 100 for 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 7 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(notification_queue_depth{namespace=\"flightdeck\"})", "legendFormat": "queued", "range": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "Notifier not reporting",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "red", "value": 100 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Notifications processed by result",
      "description": "Deliveries per second: delivered, failed (chaos), invalid (bad payload).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 7 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (result) (rate(notifications_processed_total{namespace=\"flightdeck\"}[$__rate_interval]))", "legendFormat": "{{result}}", "range": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "noValue": "Notifier not reporting", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
